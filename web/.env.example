# Bot Terboo V6 — website (env overrides config.website)
TERBOO_WEB_ENABLED=1
TERBOO_SITE_URL=https://terboo.example.com
TERBOO_WEB_HOST=127.0.0.1
TERBOO_WEB_PORT=8787
# set to 1 only when behind a trusted reverse proxy that sets X-Forwarded-For
TERBOO_WEB_TRUST_PROXY=0
# NODE_ENV=production makes the session cookie Secure (HTTPS only)
NODE_ENV=production
